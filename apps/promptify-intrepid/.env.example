# Public web config from Firebase Console > Project Settings > your Web App.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ai-transformation-510302.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ai-transformation-510302
VITE_FIREBASE_APP_ID=
VITE_REBUILD_PRODUCTION=true
# Local emulators only. Never enable on Cloud Run.
VITE_FIREBASE_AUTH_EMULATOR=
VITE_FIRESTORE_EMULATOR=
# Server env (Cloud Run secret injection / ADC). Never use VITE_ for secrets.
GOOGLE_CLOUD_PROJECT=ai-transformation-510302
PGHOST=
PGDATABASE=promptify_db
PGUSER=promptify_runtime
PGPASSWORD=
PGPOOL_MAX=5
DATABASE_URL=
GCP_SOP_BUCKET=
AI_PROVIDER=vertex
VERTEX_LOCATION=global
EMBEDDING_LOCATION=asia-southeast1
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=
EMBEDDING_MODEL=text-multilingual-embedding-002
EMBEDDING_PROVIDER=cloudsql
GCP_WAREHOUSE_ENABLED=false
BQ_LOCATION=asia-southeast1
BQ_RAW_DATASET=intrepid_raw
BQ_ANALYTICS_DATASET=intrepid_analytics
BQ_KNOWLEDGE_DATASET=intrepid_knowledge
BQ_MAX_BYTES=1000000000
# Enable after projection backfill and parity validation:
GCP_ANALYTICS_MODE=postgres
GCP_VECTOR_MODE=pgvector
RUNTIME_MODE=api
WORKER_AUDIENCE=
WORKER_INVOKER_EMAIL=
# Sheets/Drive: prefer impersonated, shared workspace SA. Secret JSON supported if required.
GOOGLE_WORKSPACE_SERVICE_ACCOUNT=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Architecture flags: default OFF. Apply additive SQL013/014/015 and validate rollback before enabling.
PROVIDER_ADMISSION_MODE=disabled
GENERATION_MODE=sync
JUDGE_FENCING_MODE=legacy
AI_WORKER_ISOLATED=false
# Async Generation may reuse the EXISTING Judge queue (no new recurring resource).
# GENERATION_QUEUE=projects/PROJECT/locations/REGION/queues/EXISTING_QUEUE
# GENERATION_WORKER_URL=https://EXISTING_REACHABLE_WORKER/
# Dedicated AI worker uses RUNTIME_MODE=ai-worker; never repurpose an active roster/projection worker blindly.

# Reference test-log gaps (all default OFF). Apply additive SQL 016 before enabling the first three.
# TC-AUTH-04: per-learner access expiry; after it the class is read-only (no Run/Judge/submissions).
ACCESS_EXPIRY_MODE=off
# TC-SEC-03: cumulative Generation tokens per learner/lesson session (e.g. 50000). Empty or 0 = off.
SESSION_TOKEN_CAP=
# TC-SEC-04: prompt-injection screening: off | log | block (Studio can allow adversarial practice per lab).
INJECTION_GUARD=off
# TC-PLAY-02: /api/stream on the Cloud Run URL (Hosting buffers responses). Needs CORS_ORIGINS to list the web origin.
GENERATION_STREAM=false
# Web build: Cloud Run origin used for streaming, e.g. https://SERVICE-PROJECTNUMBER.REGION.run.app (empty = JSON path).
VITE_STREAM_API_URL=
