# Production Cloud Run API environment (non-secret values only). Model, Judge strategy and scoring are unchanged.
# PGPASSWORD comes from Secret Manager intrepid-prod-db-password, never from this file.
GOOGLE_CLOUD_PROJECT=ai-transformation-510302
RUNTIME_MODE=api
PGHOST=/cloudsql/ai-transformation-510302:asia-southeast1:promptify-prod
PGDATABASE=promptify_db
PGUSER=promptify_runtime
PGPOOL_MAX=5
GCP_SOP_BUCKET=ai-transformation-510302-intrepid-sop-prod
AI_PROVIDER=vertex
VERTEX_LOCATION=global
EMBEDDING_LOCATION=asia-southeast1
GEMINI_MODEL=gemini-3.8-flash
JUDGE_STRATEGY=parallel-v1
JUDGE_MODE=async
JUDGE_STREAM=true
GCP_ANALYTICS_MODE=postgres
GCP_VECTOR_MODE=pgvector
EMBEDDING_PROVIDER=cloudsql
GCP_WAREHOUSE_ENABLED=false
# Hardening that staging does not force (02/11/2026):
# TM-002 classes of a client without a configured domain are hidden.
DOMAIN_POLICY=require
# TM-005 / D11 public Basic enrollment is out of Phase 1 scope. Remove only after an owner decision.
DISABLE_PUBLIC_BASIC=true
INJECTION_GUARD=block
ACCESS_EXPIRY_MODE=enforce
# SESSION_TOKEN_CAP stays unset until the owner chooses soft vs strict session budgets (I04).
CORS_ORIGINS=https://ai-transformation-510302-intrepid-prod.web.app
