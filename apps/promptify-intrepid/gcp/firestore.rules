rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // Invalidation notices contain no prompts, scores, names or SOP contents.
  // Cloud Run rechecks SQL permissions before delivering any protected data.
  match /userUpdates/{uid}/classes/{classId} {
   allow read: if request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
   allow write: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
