{
  "hosting": {
    "site": "ai-transformation-510302-intrepid-staging",
    "public": "dist",
    "ignore": ["firebase.json", "firebase.staging.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {"source": "/api/**", "run": {"serviceId": "promptify-intrepid-api", "region": "asia-southeast1"}},
      {"source": "**", "destination": "/index.html"}
    ],
    "headers": [{"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-store"}]}]
  }
}
